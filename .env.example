# RAG service runtime (keep real values in an uncommitted .env file or secret store)
RAG_ENVIRONMENT=development
RAG_DATABASE_URL=postgresql+psycopg2://rag_service:change-me@localhost:5432/rag_service
RAG_STORAGE_BACKEND=filesystem
RAG_STORAGE_PATH=./data/documents
RAG_MAX_UPLOAD_BYTES=26214400
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=Qwen3-Embedding-0.6B
RAG_EMBEDDING_DIMENSIONS=1024
RAG_EMBEDDING_ENDPOINT=http://localhost:8080/v1
RAG_EMBEDDING_TIMEOUT=30
RAG_EMBEDDING_BATCH_SIZE=32
RAG_DAGSTER_URL=http://localhost:3000
RAG_DAGSTER_LOCATION=rag-service
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_SOURCE_REVISION=unknown
RAG_RELEASE_REVISION=unknown
RAG_MCP_PATH=/mcp
RAG_MCP_ALLOWED_HOSTS=["localhost:*","127.0.0.1:*","[::1]:*"]
RAG_MCP_ALLOWED_ORIGINS=["http://localhost:*","http://127.0.0.1:*","http://[::1]:*"]
# For S3, set RAG_STORAGE_BACKEND=s3 and inject AWS credentials at runtime.
# RAG_S3_BUCKET=source-documents
# RAG_S3_ENDPOINT=https://s3.example.com
# RAG_S3_REGION=us-east-1
# For OpenRouter, also configure model, dimensions, endpoint, and runtime API key.
# RAG_EMBEDDING_API_KEY=
